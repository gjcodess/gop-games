# Browser-safe Supabase configuration. Never put a Supabase secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
VITE_APP_URL=http://localhost:5173

# Feature flags are deliberately off until their implementation phases are complete.
VITE_FEATURE_FEEDBACK=false
VITE_FEATURE_NEWSLETTER=false
VITE_FEATURE_COOKIE_BANNER=false
VITE_FEATURE_FAQ=false
VITE_FEATURE_OUTBOUND_UTM=false
